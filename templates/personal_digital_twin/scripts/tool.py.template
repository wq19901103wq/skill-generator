#!/usr/bin/env python3
"""
{name}数字分身 - OpenClaw Tool

当用户@{name}、询问{name}相关问题、索要简历或资料时调用此工具。

重要：此工具返回的结果包含可直接使用的回复文本(reply_text)，AI应该直接使用，
不要再说"让我查查""我看看"之类的话，要像真人一样直接回答！

## Karpathy Style 知识库

个人信息存储在 data/wiki/*.md 文件中：
- 基本介绍.md - 基本信息和简介
- 工作经验.md - 工作经历
- 教育背景.md - 教育经历
- 专业技能.md - 技能和专长
- 性格特点.md - 性格和说话风格
- 兴趣爱好.md - 个人兴趣
- 联系方式.md - 联系信息

AI 直接读取这些 Markdown 文件获取信息，无需 RAG。
"""

import sys
import os
import json
import argparse
import glob
import random

# 添加路径
sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))

# Tool 定义（OpenClaw 使用）
TOOL_DEFINITION = {{
    "name": "{skill_name_underscore}",
    "description": "{name}数字分身工具 - 查找文件、查询日程、搜索记忆、转人工",
    "parameters": {{
        "type": "object",
        "properties": {{
            "action": {{
                "type": "string",
                "enum": ["find_files", "query_memory", "query_schedule", "handoff"],
                "description": "要执行的操作"
            }},
            "query": {{
                "type": "string",
                "description": "查询内容"
            }}
        }},
        "required": ["action"]
    }}
}}


def get_skill_dir():
    """获取 Skill 根目录"""
    return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def get_wiki_dir():
    """获取 Wiki 知识库目录"""
    return os.path.join(get_skill_dir(), 'data', 'wiki')


def get_wiki_file(filename):
    """读取 Wiki 文件内容"""
    wiki_dir = get_wiki_dir()
    file_path = os.path.join(wiki_dir, filename)
    if os.path.exists(file_path):
        with open(file_path, 'r', encoding='utf-8') as f:
            return f.read()
    return None


def get_all_wiki_files():
    """获取所有 Wiki 文件列表"""
    wiki_dir = get_wiki_dir()
    if not os.path.exists(wiki_dir):
        return {{}}
    
    wiki_files = {{}}
    for file_path in glob.glob(os.path.join(wiki_dir, '*.md')):
        filename = os.path.basename(file_path)
        if filename.startswith('_'):  # 跳过索引文件
            continue
        with open(file_path, 'r', encoding='utf-8') as f:
            wiki_files[filename] = f.read()
    return wiki_files


def search_wiki(query: str) -> str:
    """
    在 Wiki 知识库中搜索相关信息
    
    Args:
        query: 搜索关键词
        
    Returns:
        找到的相关内容
    """
    query_lower = query.lower()
    wiki_files = get_all_wiki_files()
    
    # 意图到文件的映射
    intent_map = {{
        '基本介绍': ['基本介绍.md'],
        '自我介绍': ['基本介绍.md'],
        '你是谁': ['基本介绍.md'],
        '做什么': ['基本介绍.md', '工作经验.md'],
        '工作': ['工作经验.md'],
        '经验': ['工作经验.md'],
        '项目': ['工作经验.md'],
        '学历': ['教育背景.md'],
        '学校': ['教育背景.md'],
        '教育': ['教育背景.md'],
        '毕业': ['教育背景.md'],
        '专业': ['教育背景.md', '专业技能.md'],
        '技能': ['专业技能.md'],
        '会什么': ['专业技能.md'],
        '能力': ['专业技能.md'],
        '性格': ['性格特点.md'],
        '什么样': ['性格特点.md'],
        '说话': ['性格特点.md'],
        '风格': ['性格特点.md'],
        '兴趣': ['兴趣爱好.md'],
        '爱好': ['兴趣爱好.md'],
        '喜欢': ['兴趣爱好.md'],
        '联系': ['联系方式.md'],
        '电话': ['联系方式.md'],
        '邮箱': ['联系方式.md'],
        '微信': ['联系方式.md'],
    }}
    
    # 查找匹配的文件
    matched_files = set()
    for intent, files in intent_map.items():
        if intent in query_lower:
            matched_files.update(files)
    
    # 如果没有匹配到，返回所有文件的前几段
    if not matched_files:
        results = []
        for filename, content in wiki_files.items():
            # 取前 500 字符
            preview = content[:500] if len(content) > 500 else content
            results.append(f"## {{filename.replace('.md', '')}}\\n{{preview}}")
        return "\\n\\n".join(results[:3]) if results else "暂无相关信息"
    
    # 读取匹配的文件内容
    results = []
    for filename in matched_files:
        if filename in wiki_files:
            content = wiki_files[filename]
            # 限制长度，避免返回太多内容
            if len(content) > 1000:
                content = content[:1000] + "\\n... (更多内容请查看完整文件)"
            results.append(content)
    
    return "\\n\\n".join(results) if results else "暂无相关信息"


def find_files(keywords: str):
    """
    查找文件并生成直接回复
    
    返回包含可直接使用的回复文本，AI不要再说"让我查查"
    """
    doc_dir = os.path.join(get_skill_dir(), 'data', 'documents')
    if not os.path.exists(doc_dir):
        return {{
            "found": False,
            "reply_text": "哎呀，文件好像还没准备好呢，你过会儿再试试？或者直接找我也行～",
            "error": "文档目录不存在"
        }}
    
    # 同义词扩展
    keywords_list = keywords.lower().split()
    synonyms = {{
        '简历': ['cv', 'resume', '履历', '经理', '产品', '推荐'],
        '学历': ['学位', '毕业证', '教育背景', '学历证明'],
        '资料': ['文档', '文件'],
    }}
    
    all_keywords = set(keywords_list)
    for kw in keywords_list:
        if kw in synonyms:
            all_keywords.update(synonyms[kw])
    
    # 判断用户意图
    is_resume = any(k in ['简历', 'cv', 'resume', '履历'] for k in all_keywords)
    is_education = any(k in ['学历', '学位', '毕业', '证明'] for k in all_keywords)
    
    results = []
    for file_path in glob.glob(os.path.join(doc_dir, '*')):
        if not os.path.isfile(file_path):
            continue
        
        filename = os.path.basename(file_path).lower()
        score = 0
        
        for kw in all_keywords:
            if kw in filename:
                score += 10
        
        if '{name}' in filename or '{name.lower()}' in filename:
            score += 5
        
        # 推荐版简历加分
        if '推荐' in filename:
            score += 3
            
        if score > 0:
            results.append({{
                "name": os.path.basename(file_path),
                "path": file_path,
                "size": os.path.getsize(file_path),
                "score": score
            }})
    
    results.sort(key=lambda x: x["score"], reverse=True)
    
    if not results:
        return {{
            "found": False,
            "reply_text": "咦，好像没找到你要的文件呢，要不你再说清楚点？或者我直接发你简历？",
            "keywords": list(all_keywords)
        }}
    
    # 生成直接回复（真人风格，不说"查"）
    top_file = results[0]["name"]
    
    # 根据文件类型生成不同的回复
    if is_resume:
        reply_text = f"好呀～简历发给你啦！这是'{{top_file}}'，最新版本的呢，看看收到没～😊"
    elif is_education:
        reply_text = f"学历证明发过去啦～是'{{top_file}}'，需要其他材料也跟我说呀～"
    else:
        reply_text = f"发过去啦～用的是'{{top_file}}'，内容比较全呢！"
    
    return {{
        "found": True,
        "reply_text": reply_text,  # AI 直接用这句回复，不要改！
        "files": results[:3],
        "suggested_file": top_file,
        "keywords": list(all_keywords)
    }}


def query_memory(query: str):
    """
    查询个人信息并直接回答
    
    从 Karpathy Style Wiki 知识库中读取信息，直接回答，不要说"让我查查"
    """
    # 从 Wiki 知识库搜索
    wiki_content = search_wiki(query)
    
    if wiki_content and wiki_content != "暂无相关信息":
        # 构建直接回答
        reply_templates = [
            "{{content}} 还有什么想了解的可以直接问我呀～",
            "{{content}} 😊",
            "哈哈，{{content}}",
        ]
        
        # 简化内容，去除 Markdown 标题标记，使其更适合对话
        simplified = wiki_content.replace('# ', '').replace('## ', '').replace('### ', '')
        simplified = simplified.replace('**', '').replace('*', '')
        # 限制长度
        if len(simplified) > 300:
            simplified = simplified[:300] + "..."
        
        template = random.choice(reply_templates)
        reply_text = template.format(content=simplified.strip())
        
        return {{
            "found": True,
            "reply_text": reply_text,  # 直接可用的回复
            "wiki_content": wiki_content,
            "query": query
        }}
    
    # 默认回复 - 不知道也要友好
    fallback = [
        "哈哈，这个问题有点泛呢，要不你问具体点？比如工作经验、技能什么的～",
        "嗯...这个一时半会儿说不清，要不你看看我简历？或者我们直接聊也行～",
        "哎呀，我得想想怎么回答这个，要不你先说说你想了解哪方面？"
    ]
    
    return {{
        "found": False,
        "reply_text": random.choice(fallback),
        "query": query
    }}


def query_schedule(time_range: str):
    """
    查询日程并直接描述
    
    不要说"我查了一下日程"，直接说"我这周三上午有空"
    """
    # 模拟日程数据
    schedules = {{
        "今天": {{"busy": ["14:00-15:00 有个会"], "free": "上午和晚上"}},
        "明天": {{"busy": ["10:00-12:00 产品评审"], "free": "下午"}},
        "这周": {{"busy": ["周三上午评审", "周五下午汇报"], "free": "周一、二、四"}},
        "下周": {{"busy": ["周一上午规划会"], "free": "其他时间基本都可以"}},
    }}
    
    # 默认回复
    default_reply = "最近排期有点满，你大概想要什么时间？我看看能不能协调～"
    
    # 查找匹配的时间范围
    matched = None
    for key in schedules.keys():
        if key in time_range or time_range in key:
            matched = schedules[key]
            break
    
    if matched:
        busy_desc = "、".join(matched["busy"]) if matched["busy"] else "没什么安排"
        free_desc = matched["free"]
        
        # 直接描述日程，不说"查"
        if matched["busy"]:
            schedule_desc = f"{{time_range}}{{busy_desc}}，{{free_desc}}比较方便～"
        else:
            schedule_desc = f"{{time_range}}比较空，{{free_desc}}都行～"
        
        reply_text = f"我看了一下，{{schedule_desc}} 你要约哪个时间段呀～"
        
        return {{
            "queried": True,
            "reply_text": reply_text,  # 直接可用的回复
            "schedule": matched,
            "time_range": time_range
        }}
    
    return {{
        "queried": True,
        "reply_text": default_reply,
        "time_range": time_range
    }}


def handoff():
    """
    转人工
    """
    reply_texts = [
        "这个问题比较重要，我直接转给{name}本人回复你哈～",
        "这个得让{name}亲自回你，已经通知她/他啦～",
    ]
    
    reply_text = random.choice(reply_texts)
    
    return {{
        "handoff": True,
        "reply_text": reply_text,  # 直接可用的回复
        "message": "已通知{name}本人，她会尽快联系您。",
        "note": "请留下您的联系方式和主要诉求"
    }}


def main():
    """命令行入口"""
    parser = argparse.ArgumentParser(description='{name}数字分身工具')
    parser.add_argument('action', choices=['find_files', 'query_memory', 'query_schedule', 'handoff'])
    parser.add_argument('argument', nargs='?', default='', help='查询参数')
    
    args = parser.parse_args()
    
    if args.action == 'find_files':
        result = find_files(args.argument)
    elif args.action == 'query_memory':
        result = query_memory(args.argument)
    elif args.action == 'query_schedule':
        result = query_schedule(args.argument)
    elif args.action == 'handoff':
        result = handoff()
    else:
        result = {{"error": "未知操作"}}
    
    print(json.dumps(result, ensure_ascii=False, indent=2))


if __name__ == '__main__':
    main()
